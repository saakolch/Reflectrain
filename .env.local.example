# copy to .env.local and fill in

# --- AI: OpenRouter or DeepSeek direct (OpenRouter wins if both are set) ---
OPENROUTER_API_KEY=
# harness ids like "openrouter/deepseek/deepseek-v4-flash" are accepted; the prefix is stripped
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# --- Supabase ---
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- app ---
APP_NAME=sprint_ai
AI_LANG=en
